# R specific gitignores
.Rprofile
.Rhistory
.Rprofile
.Ruserdata
.DS_Store
*.Rproj
.Rproj.user

## ignore filtered CLIF tables stored as Rdata
*.RData

#ignore source CLIF_ files 
CLIF_*.parquet
CLIF_*.csv
CLIF_*.fst

#ignore the identifier app
CLIF_cohort_identifier*

# ignore filtered CLIF tables stored as Rdata
*.RData

# ignore pdf reports and rendered html
*.pdf
*.html

# ignore all generated analysis outputs, except the release folder of SOP.md: reviewed
# aggregates that a person copied there with release_result()
output/*
!output/final_no_phi/
output/final_no_phi/*
!output/final_no_phi/*.csv
!output/final_no_phi/*.png
!output/final_no_phi/*.pdf
!output/final_no_phi/README.md

# ignore collected per-site results for central pooling (read by pooled_estimates.R)
results/

# ignore Claude Code project files
CLAUDE.md
.claude/

# ignore working docs (not part of the consortium deliverable)
docs/

# ignore pediatric utilities and thresholds (reserved for a later project)
utils/pediatric_pbw.R
utils/psofa.R
outlier-thresholds/outlier_thresholds_pediatric_vitals.csv

# archived exploratory scratch scripts (kept locally, not part of the deliverable)
code/archive/
code/explore_*.R

# cross-cohort pooling: run centrally by the coordinator, kept local (not a
# per-site deliverable)
code/pooling/pooled_estimates.R
code/pooling/pooled_tte.R

# session-local data exports at repo root -- never commit patient-derived data
arma_pfvc_data*.csv

# local figure renders left over from the removed figures/*.py scripts
figures/

# uvr: the installed packages and the shell shim stay local; uvr.toml and uvr.lock are committed
/.uvr/library/
/.uvr/activate*

# editor settings (uvr init writes machine-specific R paths here)
.vscode/

# --- Data-zone standards (SOP.md; CLIF cloud-environment template, commit 9813e85) ---
# Site config holds local paths; only config_template.json is committed.
config/config.json
# No data files in the repo, whatever their name. Results go to results_directory,
# outside the repo; only reviewed aggregates are copied to output/final_no_phi/.
*.parquet
*.feather
*.arrow
*.fst
*.csv
*.tsv
*.xlsx
*.rds
*.rda
*.pkl
*.pickle
*.h5
*.dcm
*.nii
*.nii.gz
*.edf
*.wfdb
logs/
__pycache__/
.venv/
.ipynb_checkpoints/
# reference tables that are code, not data
!outlier-thresholds/*.csv
!output/final_no_phi/*.csv
